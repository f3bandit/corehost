+static int menu_foreign_console_now(int *last_vt_, unsigned long *idle_since_);
+static int shown_vt(void)
+{
+	int fd = open("/dev/tty0", O_RDONLY | O_CLOEXEC);
+	if (fd < 0) return 1;
+	struct vt_stat vs = {};
+	int r = ioctl(fd, VT_GETSTATE, &vs);
+	close(fd);
+	return r ? 1 : vs.v_active;
+}
+int menu_foreign_console(void)
+{
+	static int last_vt, cached;
+	static unsigned long idle_since, next;
+	if (next && !CheckTimer(next)) return cached;      // (asked every pass while it waits: a look every 250 ms)
+	next = GetTimer(250);
+	return cached = menu_foreign_console_now(&last_vt, &idle_since);
+}
+
+static int menu_foreign_console_now(int *last_vt_, unsigned long *idle_since_)
+{
+	int &last_vt = *last_vt_;
+	unsigned long &idle_since = *idle_since_;
+	int fd = open("/dev/tty0", O_RDONLY | O_CLOEXEC);
+	if (fd < 0) return 0;
+	struct vt_stat vs = {};
+	int r = ioctl(fd, VT_GETSTATE, &vs);
+	close(fd);
+	if (r || vs.v_active <= 2) { last_vt = 0; return 0; }
+	if (vs.v_active != last_vt) { last_vt = vs.v_active; idle_since = 0; }
+	if (tty_in_use(vs.v_active)) { idle_since = 0; return vs.v_active; }
+	if (!idle_since) idle_since = GetTimer(0);
+	return GetTimer(0) - idle_since < 3000 ? vs.v_active : 0;
+}
