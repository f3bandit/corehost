+int menu_status_action(const char *p);
+char menu_conf_state(int n);                    // menu.cpp: a config string line: 'h' hidden, 'd' disabled, '.' shown          // menu.cpp: a config string T/R/t/r entry, as the OSD runs it
+
+#endif
