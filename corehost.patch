@@ -0,0 +1,1008 @@
+// corehost: Coreshell's engine, MiSTer's Main with the frontend in charge of the screen and the controllers.
+//
+// Codenames: Coreshell is Kugutsu no Jutsu (傀儡の術, the puppet technique: every stock core on its strings), corehost is
+// Infinite Tsukuyomi (無限月読: the cores run on, believing MiSTer is there), and this, corehost's ARM side, is Fushi
+// Tensei (不死転生, Orochimaru's reincarnation: it lives on in MiSTer's own Main and moves into each new one).
+//
+// Main_MiSTer as it is upstream (every core, every system's loading code, the scaler, input, saves), plus this
+// file: a local API a frontend (Phosphor, Console Mode, any other) drives instead of MiSTer's OSD. While a
+// frontend is connected and has the screen, Main's own menu never opens; when none is (none started, or it
+// went away), Main's menu is there as always, so nobody is ever locked out.
+//
+// Ported from Phosphor's Main (phosphor-main/phosphor.cpp): the same socket protocol and command names, so a
+// frontend written for Phosphor's Main talks to corehost by changing only the socket path.
+//
+// Socket: /tmp/corehost.sock (COREHOST_SOCK overrides), one command per line, one JSON reply per line.
+//   hello                    {"ok":true,"api":1,"name":"corehost",...}
+//   status                   core, menu, osd, fb, owner, sheet, file
+//   subscribe                events to this client: core, osd, menu_button, pad, ingame, file, info
+//   screen frontend|main     the menu core's screen: the frontend's framebuffer, or Main's menu
+//                            ("screen phosphor" is the same as "screen frontend")
+//   sheet on|off             in a game, the menu button goes to the frontend ({"event":"menu_button"})
+//   ingame on|off            the frontend's framebuffer over the running game (its in-game menu)
+//   ingame osd               Main's own menu over the game, for what the frontend doesn't do yet
+//   confstr                  the running core's config string, every line, and each line's state (shown/hidden/disabled)
+//   opt O<bits>|o<bits> [v]  a status field: read it, or set it and read it
+//   action <line>            the config string's line <line> (a T/R/t/r entry) run as the OSD runs it,
+//                            each system's own handling with it (Mega CD, PSX, Saturn, N64 resets ...)
+//   reset                    the core's own Reset (its first R/r entry), or the keyboard reset held 1 s
+//   here <file.mgl>          an MGL's options, files, mounts and resets on the running core (no reload)
+//   launch <path>            an .rbf, .mra or .mgl
+//   screenshot               MiSTer's screenshot of the running game
+//   osdtext                  the OSD's rows as text (tests: what the OSD shows)
+//   frontend NAME            the frontend's name: "Return to NAME" in every core's menu (else the name it gave Coreshell)
+//   script PATH              (the frontend, owning the screen, in the menu core) run a script the way MiSTer's Scripts menu
+//                            does: /tmp/script on tty2, MiSTer's terminal, "Press any key to continue"; then event
+//                            {"event":"script_done","status":N} and the frontend has the screen again (docs/stock-behaviour.md)
+//   display                  the kernel's framebuffer checked as Main uses it: usable, or why not (a frontend is
+//                            refused the screen then, and MiSTer's OSD stays: never a black screen)
+// Each command here calls the function Main's own menu calls: nothing is written twice.
+//
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 f3bandit. Part of corehost, a fork of Main_MiSTer (Alexey Melnikov "Sorgelig" and the MiSTer devs),
+// under Main_MiSTer's licence: GPL-3.0 or later (see LICENSE). Programs that only talk to corehost over its socket
+// (Coreshell, frontends) are separate works under their own licences (NOTICE).
+#include "corehost.h"
+#include "scaler.h"
+#include "menu.h"
+#include "user_io.h"
+#include "video.h"
+#include "fpga_io.h"
+#include "file_io.h"
+#include "input.h"
+#include "hardware.h"
+#include "support/arcade/mra_loader.h"
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/fb.h>
+#include <sys/ioctl.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <sys/un.h>
+#include <unistd.h>
+#include <signal.h>
+
+#define CH_API 1
+#define CH_SOCK "/tmp/corehost.sock"
+#define CH_MAX 4
+#define CH_LINE 1024
+
+// the upstream Main this corehost was built on, and how many times it has moved to a new one (build.sh writes it)
+#if __has_include("corehost_version.h")
+#include "corehost_version.h"
+#endif
+#ifndef COREHOST_UPSTREAM
+#define COREHOST_UPSTREAM "unknown"
+#endif
+#ifndef COREHOST_LIVES
+#define COREHOST_LIVES 0
+#endif
+
+typedef struct {
+	int fd;
+	int subscribed;
+	size_t len;
+	char buf[CH_LINE];
+} ch_client_t;
+
+static int lfd = -1;
+static ch_client_t cl[CH_MAX];
+static int inited;
+static int owner = -1;           // the client that owns the screen and the controllers, -1: Main
+static char fe_name[40];         // the frontend's name at +1; [0]: 0 none, 1 set by `frontend`, 2 from Coreshell
+static int sheet_client = -1;    // the client that takes the menu button in a game
+static int ingame_client = -1;   // the frontend's framebuffer is over the running game for this client
+static uint32_t rep_mask;        // the held direction repeated to the frontend, 0: none
+static unsigned long rep_next;
+static char last_core[64];
+static int last_osd = -1;
+static int osd_direct;           // Main's own menu key press and release, from "ingame osd": straight through
+static unsigned long osd_release;
+static unsigned long hold_until; // the menu core waits for a frontend until then (no OSD); 0: no wait
+static char cur_file[1024];
+
+// ---- the kernel's display (self-healing with Coreshell's kernel.py): before a frontend gets the screen, the kernel's
+// framebuffer is checked to be where Main shows it (video.cpp FB_ADDR + 4096) and the shape MiSTer's driver was given.
+// The frontend stays in charge whenever it can draw. Only if it can't (a Linux update moved the framebuffer) is the
+// screen kept on the OSD, which the FPGA draws without Linux: never a black screen. Coreshell's kernel verdict is passed
+// on in the "display" command and event (a frontend can warn the user), never used to take the screen.
+#define CH_FB_ADDR (0x20000000 + (32 * 1024 * 1024) + 4096)   // (video.cpp FB_ADDR + 4096: the first page is the driver's)
+static int disp_ok = -1;                 // -1 not checked yet, 1 fine, 0 not usable
+static char disp_why[200];
+static char disp_info[200];
+static char disp_cs[16];                // Coreshell's kernel state, as it wrote it ("" if none)
+
+static long sys_num(const char *path)
+{
+	char b[32] = {};
+	int fd = open(path, O_RDONLY | O_CLOEXEC);
+	if (fd < 0) return -1;
+	int n = (int)read(fd, b, sizeof(b) - 1);
+	close(fd);
+	return n > 0 ? strtol(b, NULL, 10) : -1;
+}
+
+static int display_check(void)
+{
+	disp_why[0] = 0;
+	struct fb_var_screeninfo v;
+	struct fb_fix_screeninfo f;
+	int fd = open("/dev/fb0", O_RDWR | O_CLOEXEC);
+	if (fd < 0) { snprintf(disp_why, sizeof(disp_why), "no framebuffer (/dev/fb0)"); return disp_ok = 0; }
+	int q = ioctl(fd, FBIOGET_VSCREENINFO, &v) || ioctl(fd, FBIOGET_FSCREENINFO, &f);
+	close(fd);
+	if (q) { snprintf(disp_why, sizeof(disp_why), "the framebuffer doesn't answer FBIOGET_*SCREENINFO"); return disp_ok = 0; }
+	snprintf(disp_info, sizeof(disp_info), "%ux%u, %u bits, %u bytes a row, at 0x%08lx", v.xres, v.yres, v.bits_per_pixel,
+	         f.line_length, (unsigned long)f.smem_start);
+	if (f.smem_start != CH_FB_ADDR)
+		snprintf(disp_why, sizeof(disp_why), "the framebuffer is at 0x%08lx, Main shows 0x%08x", (unsigned long)f.smem_start, CH_FB_ADDR);
+	else if (v.bits_per_pixel != 32)
+		snprintf(disp_why, sizeof(disp_why), "the framebuffer is %u bits a pixel, Main gives it 32", v.bits_per_pixel);
+	else if (f.line_length < v.xres * 4)
+		snprintf(disp_why, sizeof(disp_why), "the framebuffer's rows (%u bytes) are shorter than its width", f.line_length);
+	else {
+		long w = sys_num("/sys/module/MiSTer_fb/parameters/width"), h = sys_num("/sys/module/MiSTer_fb/parameters/height");
+		if (w > 0 && h > 0 && (w != (long)v.xres || h != (long)v.yres))
+			snprintf(disp_why, sizeof(disp_why), "MiSTer's driver was given %ldx%ld, the framebuffer says %ux%u", w, h, v.xres, v.yres);
+	}
+	// Coreshell's own verdict (kernel.py: ok, adapted, degraded) is passed on, never a reason to take the screen: it also
+	// covers uinput, /dev/mem and the reserved memory, and the frontend stays in charge while it can draw.
+	disp_cs[0] = 0;
+	int sf = open("/media/fat/coreshell/state/kernel/state", O_RDONLY | O_CLOEXEC);
+	if (sf >= 0)
+	{
+		int n = (int)read(sf, disp_cs, sizeof(disp_cs) - 1);
+		close(sf);
+		disp_cs[n > 0 ? n : 0] = 0;
+		for (char *c = disp_cs; *c; c++) if (*c < 'a' || *c > 'z') { *c = 0; break; }
+	}
+	return disp_ok = disp_why[0] ? 0 : 1;
+}
+
+static void send_line(int i, const char *s);
+
+// ---- scripts (Update All, the downloader, Scripts/*.sh), run the way MiSTer's Scripts menu runs them (ported from
+// Phosphor's Main: docs/stock-behaviour.md)
+static pid_t script_pid;
+static int script_state, script_client = -1, script_status;   // state: 0 none, 1 running, 2 "press any key"
+int video_chvt(int num);
+
+static void script_finish(void)
+{
+	script_state = 0;
+	video_chvt(1);
+	video_fb_console_done();
+	if (script_client >= 0 && cl[script_client].fd >= 0)
+	{
+		char ev[80];
+		snprintf(ev, sizeof(ev), "{\"event\":\"script_done\",\"status\":%d}", script_status);
+		send_line(script_client, ev);
+	}
+	script_client = -1;
+}
+
+static void script_start(int i, const char *path)
+{
+	struct stat sb;
+	if (owner != i || !is_menu()) { send_line(i, "{\"ok\":false,\"error\":\"take the screen first (screen phosphor)\"}"); return; }
+	if (script_state) { send_line(i, "{\"ok\":false,\"error\":\"a script is running\"}"); return; }
+	if (strncmp(path, "/media/", 7) || strstr(path, "..") || strchr(path, '"') || strchr(path, '$') || strchr(path, '`')
+		|| stat(path, &sb) || !S_ISREG(sb.st_mode))
+	{
+		send_line(i, "{\"ok\":false,\"error\":\"no such script\"}");
+		return;
+	}
+	static char cmd[2048];
+	// through Coreshell's runner when it's installed (compat/ on the PATH; an add-on in its addons/ registry named after
+	// the frontend in its own menu): the script itself, from its folder, either way (docs/stock-behaviour.md)
+	const char *runner = access("/media/fat/coreshell/bin/run-script", X_OK) ? "" : "/media/fat/coreshell/bin/run-script ";
+	snprintf(cmd, sizeof(cmd), "#!/bin/bash\nexport LC_ALL=en_US.UTF-8\nexport HOME=/root\ncd \"$(dirname \"%s\")\"\n%s\"%s\"\n"
+		"EXITSTATUS=$?\necho \"Press any key to continue\"\nexit $EXITSTATUS\n", path, runner, path);
+	// /tmp/script, as MiSTer's Scripts menu names it: Update All (its Patreon/device check) and other scripts look for
+	// it among their parents to know they run in MiSTer's terminal, and come back the way they do on stock MiSTer
+	unlink("/tmp/script");
+	int fd = open("/tmp/script", O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0755);
+	if (fd < 0 || write(fd, cmd, strlen(cmd)) != (ssize_t)strlen(cmd)) { if (fd >= 0) close(fd); send_line(i, "{\"ok\":false,\"error\":\"can't write /tmp\"}"); return; }
+	close(fd);
+	video_fb_console();
+	video_chvt(2);
+	script_pid = fork();
+	if (!script_pid)
+	{
+		// a session of its own, so tty2 becomes the script's controlling terminal (this agetty doesn't do it:
+		// "cannot get controlling tty", and Ctrl+C, job control and the idle check saw no owner). Stock's
+		// Scripts menu skips this; its Help page (MENU_DOC) does it
+		setsid();
+		execl("/sbin/agetty", "/sbin/agetty", "-a", "root", "-l", "/tmp/script", "--nohostname", "-L", "tty2", "linux", NULL);
+		_exit(127);
+	}
+	if (script_pid < 0) { video_chvt(1); video_fb_console_done(); send_line(i, "{\"ok\":false,\"error\":\"can't start it\"}"); return; }
+	script_state = 1;
+	script_client = i;
+	script_status = 0;
+	send_line(i, "{\"ok\":true}");
+}
+
+static void script_poll(void)
+{
+	int st;
+	if (script_state == 1 && waitpid(script_pid, &st, WNOHANG) > 0)
+	{
+		script_status = WIFEXITED(st) ? WEXITSTATUS(st) : -1;
+		script_state = 2;                      // "Press any key to continue" is on the screen
+	}
+}
+
+static void display_refused(int i)
+{
+	char out[400];
+	snprintf(out, sizeof(out), "{\"ok\":false,\"error\":\"the frontend can't draw on this kernel's framebuffer, so the screen stays on the OSD: %s\"}", disp_why);
+	send_line(i, out);
+	printf("corehost: display: %s\n", disp_why);
+}
+
+static const char *sock_path(void)
+{
+	const char *p = getenv("COREHOST_SOCK");
+	return p && *p ? p : CH_SOCK;
+}
+
+static void ch_init(void)
+{
+	inited = 1;
+	// on the menu core, Main's menu waits a moment for a frontend to connect (COREHOST_HOLD_MS, 10 s by default):
+	// none in that time, and Main's menu is shown as always
+	const char *h = getenv("COREHOST_HOLD_MS");
+	long ms = h && *h ? strtol(h, NULL, 10) : 10000;
+	if (ms > 0) hold_until = GetTimer(ms);
+	for (int i = 0; i < CH_MAX; i++) cl[i].fd = -1;
+	unlink(sock_path());
+	lfd = socket(AF_UNIX, SOCK_STREAM | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+	if (lfd < 0) return;
+	struct sockaddr_un a = {};
+	a.sun_family = AF_UNIX;
+	snprintf(a.sun_path, sizeof(a.sun_path), "%s", sock_path());
+	mode_t old = umask(077);       // root only
+	int ok = bind(lfd, (struct sockaddr *)&a, sizeof(a)) == 0 && listen(lfd, 4) == 0;
+	umask(old);
+	if (!ok) { printf("corehost: can't listen on %s\n", sock_path()); close(lfd); lfd = -1; return; }
+	printf("corehost: API on %s (upstream Main %s)\n", sock_path(), COREHOST_UPSTREAM);
+}
+
+static void drop(int i);
+static void send_line(int i, const char *s)
+{
+	if (cl[i].fd < 0) return;
+	size_t n = strlen(s);
+	// small replies on a local socket: if it can't take a whole line now, the client isn't reading
+	if (send(cl[i].fd, s, n, MSG_NOSIGNAL | MSG_DONTWAIT) != (ssize_t)n || send(cl[i].fd, "\n", 1, MSG_NOSIGNAL | MSG_DONTWAIT) != 1)
+	{
+		printf("corehost: client %d not reading, dropped\n", i);
+		drop(i);
+	}
+}
+
+static void json_str(char *out, size_t n, const char *s)   // s as a JSON string body (no quotes)
+{
+	size_t j = 0;
+	for (; s && *s && j + 7 < n; s++)
+	{
+		unsigned char c = (unsigned char)*s;
+		if (c == '"' || c == '\\') { out[j++] = '\\'; out[j++] = (char)c; }
+		else if (c < 0x20) j += snprintf(out + j, n - j, "\\u%04x", c);
+		else out[j++] = (char)c;
+	}
+	out[j] = 0;
+}
+
+static void event_all(const char *s)
+{
+	for (int i = 0; i < CH_MAX; i++) if (cl[i].fd >= 0 && cl[i].subscribed) send_line(i, s);
+}
+
+static void give_back(void)
+{
+	if (owner < 0) return;
+	owner = -1;
+	if (is_menu()) menu_corehost_screen(0);
+	printf("corehost: screen back to Main\n");
+}
+
+static void ingame_end(int i)
+{
+	if (ingame_client != i) return;
+	ingame_client = -1;
+	rep_mask = 0;
+	if (!is_menu() && video_fb_state()) video_fb_enable(0);
+}
+
+static void drop(int i)
+{
+	close(cl[i].fd);
+	cl[i].fd = -1;
+	if (owner == i) give_back();      // the frontend went away: Main's menu comes back
+	if (sheet_client == i) sheet_client = -1;
+	ingame_end(i);
+}
+
+static void status_line(char *out, size_t n)
+{
+	char core[128], file[2100];
+	json_str(core, sizeof(core), user_io_get_core_name());
+	json_str(file, sizeof(file), cur_file);
+	snprintf(out, n, "{\"ok\":true,\"core\":\"%s\",\"menu\":%s,\"osd\":%s,\"fb\":%s,\"owner\":\"%s\",\"sheet\":%s,\"file\":\"%s\"}",
+		core, is_menu() ? "true" : "false", user_io_osd_is_visible() ? "true" : "false",
+		video_fb_state() ? "true" : "false", owner >= 0 ? "frontend" : "main", sheet_client >= 0 ? "true" : "false", file);
+}
+
+// the config string line n with its H/D/h/d (hide, disable) and P<n> (page) prefixes skipped; NULL: no such line
+static const char *conf_entry(int n)
+{
+	char *p = user_io_get_confstr(n);
+	if (!p) return NULL;
+	while ((p[0] == 'H' || p[0] == 'D' || p[0] == 'h' || p[0] == 'd') && strlen(p) > 2) p += 2;
+	if (p[0] == 'P' && p[1] >= '0' && p[1] <= '9' && p[2] != ',') p += 2;
+	return p;
+}
+
+// the core's own Reset: the R/T entry on status bit 0 (MiSTer's reset bit in every core; the OSD runs each disc
+// system's reset with it), or failing that one labelled "Reset", through Main's own handling. 0: the core has none.
+// (Not simply the first R entry: NES's first is "R6,Load Backup RAM".)
+static int core_reset(void)
+{
+	const char *named = NULL;
+	for (int n = 1; ; n++)
+	{
+		if (!user_io_get_confstr(n)) break;
+		const char *p = conf_entry(n);
+		if (!p[0] || !strchr("RT", p[0])) continue;
+		int bit;
+		if (user_io_status_bits(p + 1, &bit, 0, 0) == 1 && bit == 0) return menu_status_action(p) >= 0;
+		const char *label = strchr(p, ',');
+		if (!named && label && !strncasecmp(label + 1, "Reset", 5) && (!label[6] || label[6] == ',')) named = p;
+	}
+	return named && menu_status_action(named) >= 0;
+}
+
+static void command(int i, char *line)
+{
+	char out[512];
+	while (*line == ' ') line++;
+	if (!strcmp(line, "hello"))
+	{
