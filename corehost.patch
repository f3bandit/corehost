+// A config string T/R/t/r entry (a trigger, or a reset) as the OSD runs it, each system's own handling with it.
+// Moved here from HandleUI's generic menu by corehost, whose frontend API runs it too (corehost.cpp "action",
+// "reset"). Returns -1: not a one-bit option; 1: the menu closes (a reset); 0: it stays.
+int menu_status_action(const char *p)
+{
+	int bit;
+	int ex = (p[0] == 't') || (p[0] == 'r');
+	if (user_io_status_bits(p + 1, &bit, 0, ex) != 1) return -1;
+
+	const char *opt = p + 1;
+	if (!bit && (is_x86() || is_pcxt() || is_pcat286()))
+	{
+		x86_init();
+		ResetUART();
+		return 1;
+	}
+
+	if (is_megacd())
+	{
+		if (!bit) mcd_set_image(0, "");
+		if (bit == 1)
+		{
+			mcd_reset();
+			opt = "[0]";
+		}
+	}
+
+	if (is_pce() && !bit) pcecd_reset();
+	if (is_saturn() && !bit) saturn_reset();
+	if (is_n64() && !bit) n64_reset();
+	if (is_psx() && !bit) psx_reset();
+	if (is_atari800() && !bit) atari800_reset();
+	if (is_atari5200() && !bit) atari5200_reset();
+	if (is_3do() && !bit) p3do_reset();
+	if (is_pcfx() && !ex && bit == PCFX_BIT_NEW_CARD) pcfx_new_card();
+	if (is_videobrain() && !ex && (bit == VIDEOBRAIN_BIT_NEW_TAPE || bit == VIDEOBRAIN_BIT_NEW_PRINTER)) videobrain_new_image(bit);
+	if (is_pcfx() && !ex && bit == PCFX_BIT_EJECT_CARD) pcfx_eject_card();
+
+	user_io_status_set(opt, 1, ex);
+	if (is_n64() && !ex && !strcmp(opt, "[41]")) n64_save_dd_disk();
+	user_io_status_set(opt, 0, ex);
+
+	return (p[0] == 'R' || p[0] == 'r') ? 1 : 0;
+}
+
+// The config string line n with its H/h/D/d prefixes weighed as the OSD weighs them (the core's OSD mask): 'h' hidden,
+// 'd' disabled, '.' shown (corehost.cpp "confstr")
+char menu_conf_state(int n)
+{
+	const char *p = user_io_get_confstr(n);
+	if (!p) return 'h';
+	uint32_t hdmask = spi_uio_cmd16(UIO_GET_OSDMASK, 0);
+	int h = 0, d = 0;
+	while ((p[0] == 'H' || p[0] == 'D' || p[0] == 'h' || p[0] == 'd') && strlen(p) > 2)
+	{
+		int flg = (hdmask & (1 << user_io_hd_mask(p + 1))) ? 1 : 0;
+		if (p[0] == 'H') h |= flg;
+		if (p[0] == 'h') h |= (flg ^ 1);
+		if (p[0] == 'D') d |= flg;
+		if (p[0] == 'd') d |= (flg ^ 1);
+		p += 2;
+	}
+	return h ? 'h' : d ? 'd' : '.';
+}
+
+// Another program's console showing (a VT past 2: tty1 is MiSTer's terminal and the shell's, tty2 the Scripts menu's):
+// Update All's device check runs on tty3 and tty7 while the Linker core, which calls itself MENU, is loaded. Stock
+// Main leaves such a console alone; so does corehost (ported from Phosphor's Main): the screen goes to the shell once it's gone, or once nothing
+// has run on it for 3 s (Update All leaves tty7 showing when it is done; a program that gave up): the shell never
+// waits for nothing. (Update All's own gap on tty3, before its F9, is about 1.5 s; if this hands over in it, tty1 is what it
+// waits for anyway.)
+static int tty_in_use(int n)
+{
+	DIR *d = opendir("/proc");
+	if (!d) return 0;
+	struct dirent *e;
+	int used = 0;
+	while (!used && (e = readdir(d)))
+	{
+		if (e->d_name[0] < '1' || e->d_name[0] > '9') continue;
+		char path[300], buf[512];
+		snprintf(path, sizeof(path), "/proc/%s/stat", e->d_name);
+		int fd = open(path, O_RDONLY | O_CLOEXEC);
+		if (fd < 0) continue;
+		int len = read(fd, buf, sizeof(buf) - 1);
+		close(fd);
+		if (len <= 0) continue;
+		buf[len] = 0;
+		const char *p = strrchr(buf, ')');        // (after the name, which may hold spaces)
+		int tty_nr = 0;
+		if (p && sscanf(p + 2, "%*c %*d %*d %*d %d", &tty_nr) == 1 && tty_nr == ((4 << 8) | n)) used = 1;
+		// or a process with it open: a terminal whose agetty couldn't make it its controlling tty ("cannot get
+		// controlling tty") still has the program on it, waiting for the user (Update All's dialog on tty7 after its
+		// device check, taken back after 3 s for idle, Nov 2026)
+		if (!used)
+		{
+			char want[16], fdp[300], l[64];
+			snprintf(want, sizeof(want), "/dev/tty%d", n);
+			snprintf(path, sizeof(path), "/proc/%s/fd", e->d_name);
+			DIR *fdd = opendir(path);
+			struct dirent *f;
+			while (fdd && !used && (f = readdir(fdd)))
+			{
+				if (f->d_name[0] == '.') continue;
+				snprintf(fdp, sizeof(fdp), "%s/%s", path, f->d_name);
+				ssize_t ll = readlink(fdp, l, sizeof(l) - 1);
+				if (ll > 0) { l[ll] = 0; if (!strcmp(l, want)) used = 1; }
+			}
+			if (fdd) closedir(fdd);
+		}
+	}
+	closedir(d);
+	return used;
+}
