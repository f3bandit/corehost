+
+// corehost's frontend API ("here"): an MGL's options, file loads and resets on the core running now, its <rbf> not
+// loaded. The loads go through the same menu states a launch's MGL does (MENU_GENERIC_FILE_SELECTED / IMAGE_SELECTED,
+// each system's own handling with them), with the OSD kept hidden. Returns its items, -1: an MGL is still running.
+// Ported from Phosphor's Main.
+int mgl_run_here(const char *xml)
+{
+	if (!mgl.done) return -1;
+	mgl_parse(xml);
+	mgl_apply_options(0);
+	if (!mgl.count)
+	{
+		mgl.done = 1;
+		return 0;
+	}
+	mgl.current = 0;
+	mgl.state = 0;
+	mgl.timer = GetTimer(mgl.item[0].delay * 1000);
+	mgl.done = 0;
+	return mgl.count;
+}
