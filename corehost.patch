+// corehost: the menu core's screen for the frontend (1) or Main's menu (0), done in HandleUI where the menu state lives
+static int corehost_fb_req = -1;
+// The OSD's "Save settings" and "Reset settings" (System page), for a frontend's own menu: what MiSTer's menu does,
+// copied from its cases (generic core menu, case 14; MENU_RESET2), with nothing of its own
+int menu_settings_save(void)
+{
+	if (is_menu()) return -1;
+	if (is_archie()) { archie_save_config(); return 0; }
+	char *filename = user_io_create_config_name(1);
+	printf("Saving config to %s\n", filename);
+	user_io_status_save(filename);
+	if (is_x86() || is_pcxt() || is_pcat286()) x86_config_save();
+	if (is_arcade()) arcade_nvm_save();
+	return 0;
+}
+// An arcade core's DIP switches for a frontend's own screen (the OSD's MENU_ARCADE_DIP, without it): how many, each
+// one's name, choices and the one set; set one as the OSD does (sent to the core at once, saved); "Reset & apply"
+int menu_dip_count(void) { return is_menu() ? 0 : arcade_sw()->dip_num; }
+int menu_dip_get(int i, const char **name, int *num, int *cur)
+{
+	sw_struct *sw = arcade_sw();
+	if (is_menu() || i < 0 || i >= sw->dip_num) return 0;
+	uint64_t status = sw->dip_cur & sw->dip[i].mask;
+	int m = 0;
+	for (int n = 0; n < sw->dip[i].num; n++) if (status == sw->dip[i].val[n]) { m = n; break; }
+	*name = sw->dip[i].name; *num = sw->dip[i].num; *cur = m;
+	return 1;
+}
+const char *menu_dip_choice(int i, int m) { return arcade_sw()->dip[i].id[m]; }
+int menu_dip_set(int i, int m)
+{
+	sw_struct *sw = arcade_sw();
+	if (is_menu() || i < 0 || i >= sw->dip_num || m < 0 || m >= sw->dip[i].num) return -1;
+	sw->dip_cur = (sw->dip_cur & ~sw->dip[i].mask) | sw->dip[i].val[m];
+	arcade_sw_send();
+	arcade_sw_save();
+	return 0;
+}
+int menu_dip_apply(void)
+{
+	if (is_menu() || !arcade_sw()->dip_num) return -1;
+	arcade_sw_save();
+	user_io_status_set("[0]", 1);
+	user_io_status_set("[0]", 0);
+	return 0;
+}
+
+int menu_settings_reset(void)
+{
+	if (is_menu()) return -1;
+	if (is_minimig()) { minimig_reset(); return 0; }
+	user_io_status_reset();
+	char *filename = user_io_create_config_name(1);
+	printf("Saving config to %s\n", filename);
+	user_io_status_save(filename);
+	if (arcade_sw()->dip_num)
+	{
+		arcade_sw()->dip_cur = arcade_sw()->dip_def;
+		arcade_sw_send();
+		user_io_status_set("[0]", 1);
+		user_io_status_set("[0]", 0);
+		arcade_sw_save();
+	}
+	return 0;
+}
