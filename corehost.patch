+// Before the FPGA is reprogrammed: a program still writing to the running core through /dev/mem (the lightweight
+// bridge, 0xFF200000) would hit it while it's being reloaded, and the ARM's bus to the FPGA locks up: the whole
+// system freezes, network too. Update All's device check does exactly that: its "--blank-display" writer runs in the
+// background with no check of its own while the menu core is loaded again (update_all 06ab917; an SS1 froze, Nov 16
+// 2026). Its own time limit is 2 s: a core load waits up to 3 s for it to finish (ported from Phosphor's Main).
+static int fpga_writer_running(void)
+{
+	DIR *d = opendir("/proc");
+	if (!d) return 0;
+	struct dirent *e;
+	int found = 0;
+	while (!found && (e = readdir(d)))
+	{
+		if (e->d_name[0] < '1' || e->d_name[0] > '9') continue;
+		char path[300], buf[2048];
+		snprintf(path, sizeof(path), "/proc/%s/cmdline", e->d_name);
+		int fd = open(path, O_RDONLY | O_CLOEXEC);
+		if (fd < 0) continue;
+		int n = read(fd, buf, sizeof(buf) - 1);
+		close(fd);
+		if (n <= 0) continue;
+		int linker = 0, blank = 0;
+		for (int i = 0; i < n; i += strlen(buf + i) + 1)
+		{
+			buf[n] = 0;
+			if (!strcmp(buf + i, "--chip-id-linker")) linker = 1;
+			if (!strcmp(buf + i, "--blank-display")) blank = 1;
+		}
+		found = linker && blank;
+	}
+	closedir(d);
+	return found;
+}
+
+static void fpga_wait_for_writers(void)
+{
+	if (!fpga_writer_running()) return;
+	printf("FPGA: Update All is still writing to the core: waiting before the load\n");
+	for (int t = 0; t < 300 && fpga_writer_running(); t++) usleep(10000);
+}
+
 int fpga_load_rbf(const char *name, const char *cfg, const char *xml)
 {
+	fpga_wait_for_writers();   // corehost: nothing writing to the core through /dev/mem while it's reloaded
+	// the menu core by its full path (load_core /media/fat/menu.rbf: Coreshell's core dumper, add-ons) is the menu, as
+	// the bare name is (stock loads the same file either way; ported from Phosphor's Main, Nov 16 2026)
+	{
+		char mp[1024];
+		snprintf(mp, sizeof(mp), "%s/menu.rbf", getStorageDir(0));
+		if (name[0] == '/' && !strcasecmp(name, mp)) name = "menu.rbf";
+		snprintf(mp, sizeof(mp), "%s/menu.rbf", getRootDir());
+		if (name[0] == '/' && !strcasecmp(name, mp)) name = "menu.rbf";
+	}
 	smc_shim_leave_game();   // Super MemCard: the game's own save written first (its core saves when the OSD opens)
 	OsdDisable();
 	static char path[1024];
@@ -617,6 +671,11 @@ char *getappname()
 	sprintf(path, "/proc/%d/exe", getpid());
 	readlink(path, dest, PATH_MAX);
 
+	// corehost: a binary replaced while it runs (an update) reads "<path> (deleted)": the restart for the next core
+	// then runs the new file at that path, instead of failing to start and rebooting the system
+	size_t n = strlen(dest);
+	if (n > 10 && !strcmp(dest + n - 10, " (deleted)")) dest[n - 10] = 0;
+
 	return dest;
 }
 
