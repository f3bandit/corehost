+
+static void read_client(int i)
+{
+	for (;;)
+	{
+		ch_client_t *c = &cl[i];
+		ssize_t r = recv(c->fd, c->buf + c->len, sizeof(c->buf) - 1 - c->len, MSG_DONTWAIT);
+		if (r == 0 || (r < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)) { drop(i); return; }
+		if (r < 0) return;
+		c->len += (size_t)r;
+		c->buf[c->len] = 0;
+		char *nl;
+		while (cl[i].fd >= 0 && (nl = (char *)memchr(c->buf, '\n', c->len)))
+		{
+			*nl = 0;
+			if (nl > c->buf && nl[-1] == '\r') nl[-1] = 0;
+			command(i, c->buf);
+			if (cl[i].fd < 0) return;
+			size_t used = (size_t)(nl - c->buf) + 1;
+			memmove(c->buf, nl + 1, c->len - used);
+			c->len -= used;
+		}
+		if (c->len >= sizeof(c->buf) - 1) { drop(i); return; }   // a line that never ends
+	}
+}
+
+// Controllers for the frontend, the way MiSTer's own menu gets them: Main reads them, with the controller's
+// MiSTer mapping, and the frontend gets {"event":"pad","b":"up","p":1|0|2} (2: held, repeated as MiSTer's menu
+// repeats). With the framebuffer up input.cpp passes the menu buttons as MiSTer's OSD takes them: X as JOY_BTN4,
+// Y as JOY_BTN3, Start as JOY_L2, Select as JOY_R2.
+static const char *pad_name(uint32_t m)
+{
+	switch (m)
+	{
+	case JOY_UP: return "up";
+	case JOY_DOWN: return "down";
+	case JOY_LEFT: return "left";
+	case JOY_RIGHT: return "right";
+	case JOY_BTN1: return "a";
+	case JOY_BTN2: return "b";
+	case JOY_BTN4: return "x";
+	case JOY_BTN3: return "y";
+	case JOY_L: return "l";
+	case JOY_R: return "r";
+	case JOY_L2: return "start";
+	case JOY_R2: return "select";
+	default: return NULL;
+	}
+}
+
+static void pad_send(uint32_t m, int p)
+{
+	const char *b = pad_name(m);
+	if (!b || owner < 0 || cl[owner].fd < 0) return;
+	char ev[64];
+	snprintf(ev, sizeof(ev), "{\"event\":\"pad\",\"b\":\"%s\",\"p\":%d}", b, p);
+	send_line(owner, ev);
+}
+
+int corehost_pad(uint32_t mask, int press)
+{
+	if (!press && mask == rep_mask) rep_mask = 0;
+	if (script_state == 1) return 0;           // the script has the controllers (MiSTer's terminal keys)
+	if (script_state == 2) { if (press) script_finish(); return 1; }
+	if (owner < 0 || !(is_menu() || ingame_client == owner) || !pad_name(mask)) return 0;
+	pad_send(mask, press ? 1 : 0);
+	if (press && (mask & JOY_MOVE)) { rep_mask = mask; rep_next = GetTimer(320); }
+	return 1;
+}
+
+// ---- the way back to the frontend, in every core's menu (menu.cpp: "Return to <name>" on the core's System page and
+// MiSTer's): the frontend that registered, by `frontend NAME` here or with Coreshell (its frontend.json). Ported from
+// Phosphor's Main (Launch Phosphor, phosphor_start); docs/stock-behaviour.md.
+static void fe_from_coreshell(void)
+{
+	static unsigned long next;
+	if (fe_name[0] == 1 || (next && !CheckTimer(next))) return;   // (1: set here: Coreshell's not asked)
+	next = GetTimer(5000);
+	char buf[2048];
+	int fd = open("/media/fat/coreshell/state/frontend.json", O_RDONLY | O_CLOEXEC);
+	if (fd < 0) { fe_name[0] = 0; return; }
+	int n = read(fd, buf, sizeof(buf) - 1);
+	close(fd);
+	buf[n > 0 ? n : 0] = 0;
+	const char *p = strstr(buf, "\"name\"");
+	fe_name[0] = 0;
+	if (!p || !(p = strchr(p + 6, ':')) || !(p = strchr(p, '"'))) return;
+	p++;
+	size_t k = 0;
+	while (*p && *p != '"' && k < sizeof(fe_name) - 2) fe_name[1 + k++] = (*p >= 32 && *p < 127) ? *p : ' ', p++;
+	fe_name[1 + k] = 0;
+	if (k) fe_name[0] = 2;      // (2: from Coreshell)
+}
+
+const char *corehost_frontend_name(void)
+{
+	fe_from_coreshell();
+	return fe_name[0] && fe_name[1] ? fe_name + 1 : NULL;
+}
+
+int corehost_return(void)
+{
+	if (!corehost_frontend_name()) return 0;
+	if (is_menu())
+	{
+		// a frontend connected: it gets the screen again ("show" for one that gave it to MiSTer's menu)
+		for (int i = 0; i < CH_MAX; i++) if (cl[i].fd >= 0 && cl[i].subscribed)
+		{
+			event_all("{\"event\":\"show\"}");
+			if (owner >= 0) menu_corehost_screen(1);
+			return 1;
+		}
+		return 0;
+	}
+	// in a game: the menu core, where the frontend takes the screen (the "core" event)
+	fpga_load_rbf("menu.rbf");
+	return 1;
+}
+
+uint32_t corehost_filter_key(uint32_t c)
+{
+	if (!c) return c;
+	uint32_t key = c & ~UPSTROKE;
+	if (osd_direct && key == KEY_F12) { if (c & UPSTROKE) osd_direct = 0; return c; }   // "ingame osd"
+	if (script_state == 2 && (c & UPSTROKE)) { script_finish(); return 0; }   // "press any key"
+	if (script_state) return 0;                // the keyboard types into the script's terminal
+	if (owner >= 0 && is_menu())
+	{
+		// the frontend has the controls: Main's menu does nothing (no OSD, no F9, no file browser)
+		if (key == KEY_F12 && (c & UPSTROKE)) event_all("{\"event\":\"menu_button\"}");
+		// but F9 over another program's console (Update All's device check presses it on tty3): MiSTer's terminal,
+		// as stock Main opens it, which that program waits for (ported from Phosphor's Main)
+		if (key == KEY_F9 && menu_foreign_console()) return c;
+		return 0;
+	}
+	// in a game: the menu button opens the frontend's in-game menu, on the release. Only a press that began with
+	// MiSTer's OSD closed: the press that closes the OSD (opened by "ingame osd") isn't one for the frontend too
+	static int f12_down;
+	if (sheet_client >= 0 && !is_menu() && key == KEY_F12)
+	{
+		if (!(c & UPSTROKE))
+		{
+			if (user_io_osd_is_visible()) { f12_down = 0; return c; }
+			f12_down = 1;
+			return 0;
+		}
+		if (!f12_down) return c;
+		f12_down = 0;
+		event_all("{\"event\":\"menu_button\"}");
+		return 0;
+	}
+	return c;
+}
+
+int corehost_hold_menu(void)
+{
+	if (!inited) ch_init();
+	if (!hold_until) return 0;
+	if (owner >= 0 || !is_menu() || CheckTimer(hold_until)) { hold_until = 0; return 0; }
+	return 1;
+}
+
+void corehost_info(const char *message)
+{
+	if (!inited || !message) return;
+	// the OSD's text uses MiSTer's own font above 0x7f (arrows, boxes, progress bars): not UTF-8, so a space each
+	char a[600], m[700], ev[800];
+	size_t n = 0;
+	for (const char *c = message; *c && n < sizeof(a) - 1; c++) a[n++] = ((unsigned char)*c < 0x80) ? *c : ' ';
+	a[n] = 0;
+	json_str(m, sizeof(m), a);
+	snprintf(ev, sizeof(ev), "{\"event\":\"info\",\"text\":\"%s\"}", m);
+	event_all(ev);
+}
+
+void corehost_file(const char *path, int index, int mount)
+{
+	if (!path || !*path) return;
+	snprintf(cur_file, sizeof(cur_file), "%s", path);
+	if (!inited) return;
+	char p[2100], ev[2200];
+	json_str(p, sizeof(p), path);
+	snprintf(ev, sizeof(ev), "{\"event\":\"file\",\"path\":\"%s\",\"index\":%d,\"mount\":%s}", p, index, mount ? "true" : "false");
+	event_all(ev);
+}
+
+// MiSTer.ini's main= for a core: 1 to stay in corehost. corehost stands in for the Main MiSTer.ini names for the menu
+// (its [MiSTer] main=, or MiSTer): that one is remembered at the first start (COREHOST_DEFAULT_MAIN, kept across
+// corehost's own restarts) and every core that uses it stays here (the RA cores go to MiSTer_RA, as MiSTer.ini says).
+// A core whose section names another fork with its own system code still gets that Main (and the frontend loses
+// corehost's API until the menu comes back: a Main that's not corehost hands the menu to MiSTer.ini's main=).
+static const char *main_base(const char *m)
+{
+	const char *b = strrchr(m, '/');
+	return b ? b + 1 : m;
+}
+
+int corehost_keep_main(const char *cfg_main)
+{
+	if (!cfg_main || !*cfg_main) return 1;
+	const char *b = main_base(cfg_main);
+	if (!strcasecmp(b, "MiSTer") || !strcasecmp(b, "corehost") || !strcasecmp(b, "MiSTer_corehost")) return 1;
+	const char *def = getenv("COREHOST_DEFAULT_MAIN");
+	if (!def || !*def)
+	{
+		if (!is_menu()) return 0;              // (started on a game: only the menu's Main is ours)
+		setenv("COREHOST_DEFAULT_MAIN", b, 1);
+		return 1;
+	}
+	return !strcasecmp(b, def);
+}
+
+void corehost_poll(void)
+{
+	script_poll();
+	if (!inited) ch_init();
+	if (osd_release && CheckTimer(osd_release)) { osd_release = 0; menu_key_set(KEY_F12 | UPSTROKE); }
+	if (rep_mask && CheckTimer(rep_next))
+	{
+		if (owner < 0) rep_mask = 0;
+		else { pad_send(rep_mask, 2); rep_next = GetTimer(85); }
+	}
+	if (lfd < 0) return;
+
+	int fd;
+	while ((fd = accept4(lfd, NULL, NULL, SOCK_NONBLOCK | SOCK_CLOEXEC)) >= 0)
+	{
+		int slot = -1;
+		for (int i = 0; i < CH_MAX; i++) if (cl[i].fd < 0) { slot = i; break; }
+		if (slot < 0) { close(fd); continue; }
+		cl[slot].fd = fd;
+		cl[slot].subscribed = 0;
+		cl[slot].len = 0;
+	}
+	for (int i = 0; i < CH_MAX; i++) if (cl[i].fd >= 0) read_client(i);
+
+	// Main's own menu (from "ingame osd") or Main itself took the framebuffer from the in-game menu
+	if (ingame_client >= 0 && !is_menu() && !video_fb_state())
+	{
+		if (cl[ingame_client].fd >= 0) send_line(ingame_client, "{\"event\":\"ingame\",\"on\":false}");
+		ingame_client = -1;
+		rep_mask = 0;
+	}
+
+	// the kernel's display: checked at start and every 10 s; a change is an event (a frontend can tell the user)
+	static unsigned long disp_next;
+	static int disp_last = -1;
+	static char cs_last[16];
+	if (!disp_next || CheckTimer(disp_next))
+	{
+		disp_next = GetTimer(10000);
+		display_check();
+		if (disp_ok != disp_last || strcmp(disp_cs, cs_last))
+		{
+			int lost = !disp_ok && disp_last != 0;
+			disp_last = disp_ok;
+			snprintf(cs_last, sizeof(cs_last), "%s", disp_cs);
+			char why[260], e[400];
+			json_str(why, sizeof(why), disp_why);
+			snprintf(e, sizeof(e), "{\"event\":\"display\",\"usable\":%s,\"why\":\"%s\",\"coreshell\":\"%s\"}", disp_ok ? "true" : "false", why, disp_cs);
+			event_all(e);
+			if (lost)
+			{
+				printf("corehost: display: %s: the OSD keeps the screen\n", disp_why);
+				if (owner >= 0) { send_line(owner, "{\"event\":\"ingame\",\"on\":false}"); give_back(); }
+				hold_until = 0;
+			}
+		}
+	}
+
+	char core[64], ev[256], name[128];
+	snprintf(core, sizeof(core), "%s", user_io_get_core_name());
+	if (strcmp(core, last_core))
+	{
+		snprintf(last_core, sizeof(last_core), "%s", core);
+		ingame_client = -1;
+		rep_mask = 0;
+		json_str(name, sizeof(name), core);
+		snprintf(ev, sizeof(ev), "{\"event\":\"core\",\"name\":\"%s\",\"menu\":%s}", name, is_menu() ? "true" : "false");
+		event_all(ev);
+		if (owner >= 0 && is_menu()) menu_corehost_screen(1);
+	}
+	int osd = user_io_osd_is_visible() ? 1 : 0;
+	if (osd != last_osd)
+	{
+		last_osd = osd;
+		snprintf(ev, sizeof(ev), "{\"event\":\"osd\",\"open\":%s}", osd ? "true" : "false");
+		event_all(ev);
+	}
+	// the menu core reloads its video after some actions: keep the frontend's framebuffer up
+	if (owner >= 0 && is_menu() && !video_fb_state()) menu_corehost_screen(1);
+}
+
+// ---- a game's loading box, drawn by the frontend in its own style (MiSTer's OSD progress box otherwise). Main restarts
+// with each core and is busy in the load, so nothing goes over the socket: the frontend that draws it says so in
+// /tmp/corehost/draws-loading (its pid), and the load's progress is /tmp/corehost/loading ("cur max\ttitle\tfile"),
+// written as it moves and removed at the end. Shown only for a load over 350 ms (a short one: nothing at all, as before the picture);
+// Main shows the frontend's framebuffer meanwhile and gives the picture back to the core after.
+#define CH_DRAWS_LOADING "/tmp/corehost/draws-loading"
+#define CH_LOADING "/tmp/corehost/loading"
+static int loading_drawn_by_frontend(void)
+{
+	FILE *f = fopen(CH_DRAWS_LOADING, "r");
+	if (!f) return 0;
+	int pid = 0;
+	if (fscanf(f, "%d", &pid) != 1) pid = 0;
+	fclose(f);
+	return pid > 0 && kill(pid, 0) == 0;
+}
+static int ld_keep_screen;
+int corehost_loading(const char *title, const char *text, int cur, int max)
+{
+	static int on, fb_ours, last_pct = -1;
+	static unsigned long show_at;
+	if (!cur && !max)
+	{
+		int was = on;
+		if (on) { if (fb_ours && !ld_keep_screen) video_fb_enable(0); unlink(CH_LOADING); }   // (the core's picture first, then the card goes)
+		unlink(CH_LOADING ".shown");
+		on = fb_ours = 0; show_at = 0; last_pct = -1;
+		return was || (!is_menu() && loading_drawn_by_frontend());
+	}
+	if (is_menu() || !loading_drawn_by_frontend()) return 0;
+	if (!show_at) show_at = GetTimer(350);
+	if (!CheckTimer(show_at)) return 1;              // (a short load: nothing shown)
+	if (!on)
+	{
+		on = 1;
+		fb_ours = 0;
+		unlink(CH_LOADING ".shown");
+	}
+	// the frontend's screen only once its card is drawn (it says so in loading.shown): never what was in the
+	// framebuffer before (a garbled flash on the TV, Nov 2026). Ported from Phosphor's Main (phosphor.cpp).
+	if (!fb_ours && !video_fb_state() && access(CH_LOADING ".shown", F_OK) == 0)
+	{
+		fb_ours = 1;
+		video_fb_enable(1);
+	}
+	int pct = max > 0 ? (int)((int64_t)cur * 100 / max) : 0;
+	if (pct == last_pct) return 1;
+	last_pct = pct;
+	mkdir("/tmp/corehost", 0755);
+	FILE *f = fopen(CH_LOADING ".new", "w");
+	if (f)
+	{
+		fprintf(f, "%d %d\t%s\t%s\n", cur, max, title ? title : "", text ? text : "");
+		fclose(f);
+		rename(CH_LOADING ".new", CH_LOADING);
+	}
+	return 1;
+}
+
+
+// a game's save written as it's left (the Super MemCard's leave_game), shown as the frontend's card
+// ("Saving", no progress known: max 0) instead of MiSTer's OSD box. Returns 0 when the frontend doesn't draw it
+// (a CRT's OSD text, stock): the OSD box then. Ended with on = 0: the frontend's screen stays (a core is loading
+// next), never the game's picture again for a moment.
+int corehost_saving(int on)
+{
+	if (on) return corehost_loading("Saving", "", 1, 0);
+	ld_keep_screen = 1;
+	int r = corehost_loading(NULL, NULL, 0, 0);
+	ld_keep_screen = 0;
+	return r;
+}
